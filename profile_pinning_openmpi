#!/bin/bash
set -euo pipefail

# --- configuration ---------------------------------------------------------
N=${N:-1024}
MEN=${MEN:-4}
WS_N=${WS_N:-128}
WS_MEN=${WS_MEN:-3}
CFGS=${CFGS:-"1 1 1 2 1 4 1 8 1 16 1 24 1 32 1 48 1 96 8 1 8 2 8 4 8 8 8 12 2 1 4 1 8 1 16 1 24 1 32 1 48 1 96 1 1 8 2 8 4 8 2 48 3 32 4 24 6 16 16 6 24 4 32 3 48 2"}
SCOREP_MPI_ENABLE_GROUPS=${SCOREP_MPI_ENABLE_GROUPS:-"cg,coll,p2p,xnonblock"}

OUT="openmpi_profile_$(date +%Y%m%d_%H%M%S)"
mkdir -p "$OUT"
echo "Writing results to: $OUT"

# --- environment / build ---------------------------------------------------
# NOTE: This script manages per-configuration Slurm allocations via salloc,
# and launches mpirun directly so it uses the allocation without srun.
load_plain_modules() {
  module purge
  module load GCC/13.2.0
  module load OpenMPI/4.1.6-GCC-13.2.0
}

load_linaroforge_modules() {
  module purge
  module load GCC/13.2.0
  module load OpenMPI/4.1.6-GCC-13.2.0
  module load LinaroForge/25.0.3-GCCcore-13.2.0-linux-x86_64
}

load_scorep_modules() {
  module purge
  module load GCC/13.3.0
  module load OpenMPI/5.0.3-GCC-13.3.0
  module load Score-P
}

build_plain() {
  load_plain_modules
  make clean
  CXX=mpic++ CXXFLAGS="-O3 -std=c++17 -fopenmp" make
}

build_linaroforge() {
  load_linaroforge_modules
  make clean
  CXX=mpic++ CXXFLAGS="-O3 -std=c++17 -fopenmp -g" make
}

build_scorep() {
  load_scorep_modules
  make clean
  INSTR_CXX=scorep-mpicxx INSTR_CXX_FLAGS="-O3 -std=c++17 -fopenmp -g" make instr
}

build_plain
mv snowman "$OUT/snowman-plain"

build_linaroforge
mv snowman "$OUT/snowman-linaroforge"

build_scorep
mv snowman-instr "$OUT/snowman-scorep-instr"

cd "$OUT"

# --- OpenMPI process pinning -----------------------------------------------
OMPI_COMMON_OPTIONS=(
  --bind-to core
  --report-bindings
  --mca rmaps_base_oversubscribe 0
)

# --- OpenMP thread pinning inside each MPI rank ----------------------------
export OMP_PLACES=cores
export OMP_PROC_BIND=close
#export OMP_DISPLAY_ENV=VERBOSE

run_step() {
    local job_name=$1
    local module_loader=$2
    local omp_threads=$3
    local command=$4
    local log=$5
    local env_setup=${6:-}

    echo "Running ${job_name} (log: ${log})"

    (
      set -euo pipefail
      "$module_loader"
      export OMP_NUM_THREADS="$omp_threads"
      export OMP_PLACES=cores
      export OMP_PROC_BIND=close
      if [[ -n "$env_setup" ]]; then
        eval "$env_setup"
      fi
      eval "$command"
    ) >"$log" 2>&1
}

run_profiles() {
    local nprocs=$1
    local nthreads=$2

    local tag="${nprocs}procs_${nthreads}threads"
    local map_log="map_${tag}.log"
    local scorep_log="scorep_${tag}.log"
    local scorep_dir="scorep_${tag}"

    run_step \
      "map_${tag}" \
      "load_linaroforge_modules" \
      "$nthreads" \
      "map --profile mpirun -np $nprocs ${OMPI_COMMON_OPTIONS[*]} --map-by ppr:${nprocs}:node:pe=${nthreads} ./snowman-linaroforge $N $MEN" \
      "$map_log"

    run_step \
      "scorep_${tag}" \
      "load_scorep_modules" \
      "$nthreads" \
      "mpirun -np $nprocs ${OMPI_COMMON_OPTIONS[*]} --map-by ppr:${nprocs}:node:pe=${nthreads} ./snowman-scorep-instr $N $MEN" \
      "$scorep_log" \
      "export SCOREP_EXPERIMENT_DIRECTORY=\"$scorep_dir\"; export SCOREP_ENABLE_PROFILING=true; export SCOREP_ENABLE_TRACING=false; export SCOREP_MPI_ENABLE_GROUPS=\"$SCOREP_MPI_ENABLE_GROUPS\";"
}

timed_run() {
    local nprocs=$1
    local nthreads=$2
    local grid=$3
    local snowmen=$4
    local label=$5

    local tag="${nprocs}procs_${nthreads}threads_${label}"
    local log="binding_${tag}.log"

    echo "Timing config: procs=${nprocs}, threads=${nthreads}, grid=${grid}, snowmen=${snowmen} (log: ${log})" >&2

    run_step \
      "time_${tag}" \
      "load_plain_modules" \
      "$nthreads" \
      "time mpirun -np $nprocs ${OMPI_COMMON_OPTIONS[*]} --map-by ppr:${nprocs}:node:pe=${nthreads} ./snowman-plain $grid $snowmen" \
      "$log" >&2

    awk '/^real/ { sub(/m/, " "); sub(/s/, ""); print $2*60 + $3 }' "$log"
}

round() {
    awk -v x="$1" 'BEGIN{printf "%d", (x<0)?int(x-0.5):int(x+0.5)}'
}

weak_grid_size() {
    local procs=$1
    round "$(awk -v base="$WS_N" -v p="$procs" 'BEGIN{printf "%.6f", base*sqrt(p)}')"
}

run_config() {
    local nprocs=$1
    local nthreads=$2
    local weak_grid
    local weak_pixels
    local allocation_script

    weak_grid=$(weak_grid_size "$nprocs")

    allocation_script=$(cat <<EOF
set -euo pipefail
cd "$OUT"
$(declare -f load_plain_modules)
$(declare -f load_linaroforge_modules)
$(declare -f load_scorep_modules)
$(declare -f run_step)
$(declare -f run_profiles)
$(declare -f timed_run)
OMPI_COMMON_OPTIONS=(
  --bind-to core
  --report-bindings
  --mca rmaps_base_oversubscribe 0
)
SCOREP_MPI_ENABLE_GROUPS="$SCOREP_MPI_ENABLE_GROUPS"
N="$N"
MEN="$MEN"
strong_t=\$(timed_run "$nprocs" "$nthreads" "$N" "$MEN" "strong")
echo "$nthreads,$nprocs,\$strong_t" | tee -a "$CSV"
run_profiles "$nprocs" "$nthreads"
weak_t=\$(timed_run "$nprocs" "$nthreads" "$weak_grid" "$WS_MEN" "weak_${weak_grid}")
echo "$nthreads,$nprocs,$weak_grid,\$weak_t" | tee -a "$WEAK_CSV"
EOF
)

    salloc --nodes=1 --ntasks="$nprocs" --cpus-per-task="$nthreads" --exclusive --partition=intelsr_devel \
      -- /bin/bash -lc "$allocation_script"
}

CSV="runs_openmpi.csv"
WEAK_CSV="runs_openmpi_weak.csv"
echo "threads,procs,seconds" > "$CSV"
echo "threads,procs,pixels,seconds" > "$WEAK_CSV"

set -- $CFGS
while [ $# -gt 0 ]; do
  procs=$1
  threads=$2
  echo "Running config: procs=${procs}, threads=${threads}"
  run_config "$procs" "$threads"
  shift 2
done

echo "All runs finished. Map logs:"
ls map_*.log

echo "Score-P experiment directories:"
ls -d scorep_* 2>/dev/null || true

echo "Timing CSV file: $CSV"
echo "Weak scaling CSV file: $WEAK_CSV"
echo "Timing binding logs:"
ls binding_*.log
